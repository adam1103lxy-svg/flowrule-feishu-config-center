# Required. Generate a unique random value per deployment, for example:
# openssl rand -base64 48
FLOWRULE_MASTER_KEY=replace-with-at-least-32-random-characters

# Migration only. Set this temporarily to the legacy passphrase used by an existing
# deployment, start once to migrate old ciphertext, then remove it and restart.
# New deployments must leave it unset. Never commit the real value.
# FLOWRULE_LEGACY_SECRET_BOX_PASSPHRASE=replace-with-the-existing-legacy-passphrase

# Optional local logger configuration. Do not place credentials in this file.
LOG_DIR=./logs
LOG_REQUEST_BODY=true
LOG_RESPONSE_BODY=true
